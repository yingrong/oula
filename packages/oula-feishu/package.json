{
	"name": "oula-feishu",
	"version": "0.1.0",
	"description": "Feishu bot that delegates messages to the pi coding agent",
	"type": "module",
	"bin": {
		"oula-feishu": "dist/main.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsc -p tsconfig.build.json && chmod +x dist/main.js",
		"dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
	},
	"dependencies": {
		"@anthropic-ai/sandbox-runtime": "^0.0.16",
		"@larksuiteoapi/node-sdk": "^1.41.0",
		"@mariozechner/pi-agent-core": "^0.55.0",
		"@mariozechner/pi-ai": "^0.55.0",
		"@mariozechner/pi-coding-agent": "^0.55.0",
		"@sinclair/typebox": "^0.34.0",
		"chalk": "^5.6.2",
		"croner": "^9.1.0",
		"diff": "^8.0.2"
	},
	"devDependencies": {
		"@types/diff": "^7.0.2",
		"@types/node": "^24.3.0",
		"typescript": "^5.7.3"
	},
	"keywords": [
		"feishu",
		"lark",
		"bot",
		"ai",
		"agent"
	],
	"author": "",
	"license": "MIT",
	"engines": {
		"node": ">=20.0.0"
	}
}
