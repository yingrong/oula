# Oula Claw - 多入口 AI Agent 框架
# 基于 pi-mono ，致敬 OpenClaw

# Server Configuration
PORT=3000
NODE_ENV=development

# Feishu Configuration
# 使用长连接模式（WebSocket）接收事件，无需公网 IP 或域名
# 只需配置 App ID 和 App Secret 即可
FEISHU_APP_ID=your_app_id
FEISHU_APP_SECRET=your_app_secret

# 以下配置仅在 Webhook 模式下需要（长连接模式可省略）
# FEISHU_ENCRYPT_KEY=your_encrypt_key
# FEISHU_VERIFICATION_TOKEN=your_verification_token

# Agent Configuration
AGENT_MODEL_PROVIDER=openai
AGENT_MODEL_NAME=gpt-4
AGENT_API_KEY=your_api_key
AGENT_MAX_TOKENS=4096
AGENT_TEMPERATURE=0.7

# NVIDIA Kimi 配置示例
# AGENT_MODEL_PROVIDER=nvidia
# AGENT_MODEL_NAME=kimi-vision-pro
# AGENT_API_KEY=your_nvidia_api_key
# AGENT_MAX_TOKENS=4096
# AGENT_TEMPERATURE=0.7

# NVIDIA Kimi 2.5 配置示例
# AGENT_MODEL_PROVIDER=nvidia
# AGENT_MODEL_NAME=kimi-2.5
# AGENT_API_KEY=your_nvidia_api_key
# AGENT_MAX_TOKENS=4096
# AGENT_TEMPERATURE=0.7
